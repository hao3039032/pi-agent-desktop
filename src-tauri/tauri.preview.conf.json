{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Agent LW Preview",
  "mainBinaryName": "pi-agent-lw-preview",
  "identifier": "com.hao.pi-agent-lw.preview",
  "build": {
    "frontendDist": "../desktop/frontend-static"
  },
  "app": {
    "security": {
      "capabilities": ["window-controls", "desktop-dialog", "desktop-pi-ipc"]
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": { "resources/static-preview/": "static-preview/" },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installerHooks": "installer-preview-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": null
  }
}
