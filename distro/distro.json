{
  "$comment": "Distribution overlay for this fork. See docs/distro.md. Bump `revision` to publish a rebuild without an upstream change.",
  "id": "lw",
  "revision": 6,
  "app": {
    "productName": "Pi Agent LW",
    "identifier": "com.hao3039032.pi-agent-lw",
    "repository": "hao3039032/pi-agent-desktop"
  },
  "defaultBaseUrl": "https://ai-new-api.91prize.com",
  "npmMirrorUrl": "https://registry.npmmirror.com",
  "provider": {
    "id": "lw",
    "name": "LW",
    "api": "anthropic-messages",
    "defaultModel": "glm-5.3",
    "models": [
      {
        "id": "glm-5.3",
        "name": "glm-5.3",
        "reasoning": true,
        "input": [
          "text"
        ],
        "contextWindow": 1048576,
        "maxTokens": 131072,
        "thinkingLevelMap": {
          "xhigh": null,
          "max": "max",
          "high": "high",
          "low": "low"
        }
      },
      {
        "id": "glm-5.3-flash",
        "name": "glm-5.3-flash",
        "reasoning": true,
        "input": [
          "text",
          "image"
        ],
        "contextWindow": 1048576,
        "maxTokens": 128000,
        "thinkingLevelMap": {
          "max": "max",
          "high": "high",
          "low": "low"
        }
      },
      {
        "id": "minimax-m3",
        "name": "minimax-m3",
        "reasoning": true,
        "input": [
          "text",
          "image"
        ],
        "contextWindow": 1048576,
        "maxTokens": 131072
      },
      {
        "id": "claude-opus-5-5",
        "name": "Claude Opus 5.5",
        "reasoning": true,
        "input": [
          "text",
          "image"
        ],
        "contextWindow": 1000000,
        "maxTokens": 128000
      },
      {
        "id": "gpt-6-astra",
        "name": "GPT-6 Astra",
        "reasoning": true,
        "input": [
          "text",
          "image"
        ],
        "contextWindow": 272000,
        "maxTokens": 128000
      },
      {
        "id": "gemini-3.8-flash",
        "name": "Gemini 3.8 Flash",
        "api": "google-generative-ai",
        "baseUrl": "https://ai-new-api.91prize.com/v1beta",
        "reasoning": true,
        "input": [
          "text",
          "image"
        ],
        "contextWindow": 1048576,
        "maxTokens": 65536,
        "thinkingLevelMap": {
          "xhigh": "high",
          "max": "high",
          "high": "high",
          "medium": "medium",
          "low": "low",
          "minimal": "minimal"
        }
      }
    ]
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access",
    "git:github.com/hao3039032/pi-model-images",
    "npm:pi-omp-advisor",
    "git:github.com/hao3039032/pi-plan-vanguard"
  ],
  "settingsDefaults": {
    "defaultThinkingLevel": "high"
  },
  "webSearch": {
    "baseUrlKey": "geminiBaseUrl",
    "apiKeyKey": "geminiApiKey",
    "defaults": {
      "allowBrowserCookies": true,
      "provider": "gemini",
      "searchModel": "gemini-3.8-flash",
      "summaryModel": "gemini-3.5-flash-lite",
      "youtube": {
        "enabled": true,
        "preferredModel": "gemini-3.5-flash-lite"
      },
      "video": {
        "enabled": true,
        "preferredModel": "gemini-3.5-flash-lite"
      },
      "workflow": "auto-summary",
      "autoOpenBrowser": false
    }
  },
  "agentFiles": {
    "pi-plan-vanguard.json": {
      "defaultPlanTools": [
        "read",
        "bash",
        "grep",
        "find",
        "ls",
        "web_enable",
        "web_search",
        "source_check",
        "fetch_content",
        "get_search_content"
      ]
    }
  },
  "legacyAgentFiles": {
    "pi-plan-vanguard.json": [
      "pi-plan-mode.json",
      "plan-mode.json"
    ]
  },
  "agentTextFiles": {
    "WATCHDOG.yml": "# pi-omp-advisor 全局配置(用户级,所有项目生效)\n# main: false —— 常规 pi 会话默认不启动 advisor(按需用 /advisor on 临时开启)\nmain: false\nsubagents: false\n\nadvisors:\n  - name: advisor\n    model: lw/gemini-3.8-flash\n    tools: [read, grep, glob]\n    contextTokens: 48000\n"
  }
}
