{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/navigation": [
        "./static-frontend/src/shims/next/navigation.ts"
      ],
      "next/image": [
        "./static-frontend/src/shims/next/image.tsx"
      ],
      "next/dynamic": [
        "./static-frontend/src/shims/next/dynamic.tsx"
      ],
      "next/link": [
        "./static-frontend/src/shims/next/link.tsx"
      ],
      "@/lib/agent-client": [
        "./static-frontend/src/data/agent-client.ts"
      ],
      "@/lib/session-event-source": [
        "./static-frontend/src/data/session-event-source.ts"
      ],
      "@/hooks/useStateMirror": [
        "./static-frontend/src/data/state-mirror.ts"
      ],
      "@/lib/file-service": [
        "./static-frontend/src/data/file-service.ts"
      ],
      "@/lib/session-view-service": [
        "./static-frontend/src/data/session-view-service.ts"
      ],
      "@/lib/session-list-service": [
        "./static-frontend/src/data/session-list-service.ts"
      ],
      "@/lib/workspace-service": [
        "./static-frontend/src/data/workspace-service.ts"
      ],
      "@/lib/desktop-connection": [
        "./static-frontend/src/data/desktop-connection.ts"
      ],
      "@/hooks/useScheduledTasks": [
        "./static-frontend/src/data/scheduled-tasks-store.ts"
      ],
      "@/lib/scheduled-tasks/client": [
        "./static-frontend/src/data/scheduled-tasks-client.ts"
      ],
      "@/lib/mcp-service": [
        "./static-frontend/src/data/mcp-service.ts"
      ],
      "@/lib/project-trust-client": [
        "./static-frontend/src/data/project-trust-client.ts"
      ],
      "@/lib/models-service": [
        "./static-frontend/src/data/models-service.ts"
      ],
      "@/lib/enabled-models-service": [
        "./static-frontend/src/data/enabled-models-service.ts"
      ],
      "@/lib/git-status-service": [
        "./static-frontend/src/data/git-status-service.ts"
      ],
      "@/lib/worktree-service": [
        "./static-frontend/src/data/worktree-service.ts"
      ],
      "@/lib/models-config-service": [
        "./static-frontend/src/data/models-config-service.ts"
      ],
      "@/lib/models-extras-service": [
        "./static-frontend/src/data/models-extras-service.ts"
      ],
      "@/lib/session-actions-service": [
        "./static-frontend/src/data/session-actions-service.ts"
      ],
      "@/lib/font-service": [
        "./static-frontend/src/data/font-service.ts"
      ],
      "@/lib/tool-settings-service": [
        "./static-frontend/src/data/tool-settings-service.ts"
      ],
      "@/lib/artifact-settings-service": [
        "./static-frontend/src/data/artifact-settings-service.ts"
      ],
      "@/lib/chat-settings-service": [
        "./static-frontend/src/data/chat-settings-service.ts"
      ],
      "@/lib/custom-css-service": [
        "./static-frontend/src/data/custom-css-service.ts"
      ],
      "@/lib/terminal-client": [
        "./static-frontend/src/data/terminal-client.ts"
      ],
      "@/lib/plugins-client": [
        "./static-frontend/src/data/plugins-client.ts"
      ],
      "@/lib/skills-client": [
        "./static-frontend/src/data/skills-client.ts"
      ],
      "@/lib/provider-auth-service": [
        "./static-frontend/src/data/provider-auth-service.ts"
      ],
      "@/lib/provider-auth-login": [
        "./static-frontend/src/data/provider-auth-login.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
