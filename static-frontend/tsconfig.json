{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/navigation": [
        "./static-frontend/src/shims/next/navigation.ts"
      ],
      "next/image": [
        "./static-frontend/src/shims/next/image.tsx"
      ],
      "next/dynamic": [
        "./static-frontend/src/shims/next/dynamic.tsx"
      ],
      "next/link": [
        "./static-frontend/src/shims/next/link.tsx"
      ],
      "@/lib/agent-client": [
        "./static-frontend/src/data/agent-client.ts"
      ],
      "@/lib/session-event-source": [
        "./static-frontend/src/data/session-event-source.ts"
      ],
      "@/hooks/useStateMirror": [
        "./static-frontend/src/data/state-mirror.ts"
      ],
      "@/lib/file-service": [
        "./static-frontend/src/data/file-service.ts"
      ],
      "@/lib/session-view-service": [
        "./static-frontend/src/data/session-view-service.ts"
      ],
      "@/lib/session-list-service": [
        "./static-frontend/src/data/session-list-service.ts"
      ],
      "@/lib/workspace-service": [
        "./static-frontend/src/data/workspace-service.ts"
      ],
      "@/lib/desktop-connection": [
        "./static-frontend/src/data/desktop-connection.ts"
      ],
      "@/hooks/useScheduledTasks": [
        "./static-frontend/src/data/scheduled-tasks-store.ts"
      ],
      "@/lib/project-trust-client": [
        "./static-frontend/src/data/project-trust-client.ts"
      ],
      "@/lib/models-service": [
        "./static-frontend/src/data/models-service.ts"
      ],
      "@/lib/enabled-models-service": [
        "./static-frontend/src/data/enabled-models-service.ts"
      ],
      "@/lib/models-config-service": [
        "./static-frontend/src/data/models-config-service.ts"
      ],
      "@/lib/font-service": [
        "./static-frontend/src/data/font-service.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
